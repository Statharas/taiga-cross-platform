/*
References:
https://doc.qt.io/qt-6/stylesheet-syntax.html
https://doc.qt.io/qt-6/stylesheet-reference.html
https://doc.qt.io/qt-6/stylesheet-examples.html
*/

/* Menubar */

QMenuBar {
  background-color: transparent;
}

/* Toolbar */

QMainWindow > QToolBar {
  border-bottom-width: 1px;
  border-bottom-style: solid;
  padding: 3px 6px;
  spacing: 4px;
}

QMainWindow > QToolBar QLineEdit {
  padding: 2px 6px;
  min-height: 20px;
}

QToolButton::menu-indicator {
  width: 0px;
}

/* Checkboxes */

QCheckBox::indicator,
QTreeView::indicator,
QTreeWidget::indicator,
QTableView::indicator,
QTableWidget::indicator,
QListView::indicator {
  background-color: #fff;
  border: 1px solid #000;
  height: 13px;
  width: 13px;
}

QCheckBox::indicator:hover,
QTreeView::indicator:hover,
QTreeWidget::indicator:hover,
QTableView::indicator:hover,
QTableWidget::indicator:hover,
QListView::indicator:hover {
  border: 2px solid #000;
}

QCheckBox::indicator:checked,
QTreeView::indicator:checked,
QTreeWidget::indicator:checked,
QTableView::indicator:checked,
QTableWidget::indicator:checked,
QListView::indicator:checked {
  image: url(:/icons/check.svg);
}

QCheckBox::indicator:disabled,
QTreeView::indicator:disabled,
QTreeWidget::indicator:disabled,
QTableView::indicator:disabled,
QTableWidget::indicator:disabled,
QListView::indicator:disabled {
  background-color: #eee;
  border-color: #777;
}

/* Navigation */

QTreeWidget#navigation {
  background-color: transparent;
  outline: none;
  padding: 4px 6px;
  selection-color: #000;
}

QTreeWidget#navigation::item {
  background-color: transparent;
  border-radius: 0px;
  padding-left: 2px;
  padding-right: 2px;
}

/* List */

QStackedWidget QListView,
QStackedWidget QTreeView {
  border-top-width: 1px;
  border-top-style: solid;
}

QTreeView#animeList QHeaderView {
  border-bottom-width: 1px;
  border-bottom-style: solid;
}

QTreeView#animeList QHeaderView::section,
QTreeView#historyView QHeaderView::section,
QTreeView#libraryView QHeaderView::section {
  font-weight: 400;
  height: 24px;
  padding-left: 8px;
  padding-right: 8px;
}

QTreeView#animeList,
QTreeView#historyView,
QTreeView#libraryView {
  selection-background-color: transparent;
}

QTreeView#animeList::item,
QTreeView#historyView::item,
QTreeView#libraryView::item {
  padding-left: 6px;
  padding-right: 6px;
}

QTreeView#historyView::item,
QTreeView#libraryView::item {
  height: 24px;
}

QTableWidget#torrentList {
  outline: none;
  show-decoration-selected: 1;
}

QTableWidget#torrentList QHeaderView::section {
  font-weight: 400;
  height: 22px;
  padding-left: 4px;
  padding-right: 4px;
}

QTableWidget#torrentList::item {
  border: none;
  padding-left: 4px;
  padding-right: 4px;
}

/* Now Playing */

#nowPlaying {
  border-top-width: 1px;
  border-top-style: solid;
}

/* Statusbar */

QStatusBar#statusbar {
  border-top-width: 1px;
  border-top-style: solid;
}
